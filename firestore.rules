rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth()  { return request.auth != null; }
    function uid()     { return request.auth.uid; }

    function role() {
      return isAuth() ? get(/databases/$(database)/documents/users/$(uid())).data.role : null;
    }

    function isAdmin() { return role() == "admin"; }
    function isStaff() { return role() == "staff" || role() == "admin"; }
    function isSelf(userId) { return isAuth() && uid() == userId; }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // list público necesario para checkDisplayNameTaken en registro (sin sesión)
      allow get:    if isAuth() || true;
      allow list:   if isAuth();

      allow create: if isSelf(userId);

      // El usuario no puede cambiarse el role
      allow update: if isAdmin()
        || (isSelf(userId) && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    // ── Players ───────────────────────────────────────────────────────────────
    match /players/{playerId} {
      allow read:   if isAuth();
      allow create: if isStaff()
        || (isAuth() && request.resource.data.userId == uid());
      allow update: if isStaff()
        || (isAuth() && resource.data.userId == uid());
      allow delete: if isAdmin();
    }

    // ── Config ─────────────────────────────────────────────────────────────────
    match /config/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Parts ─────────────────────────────────────────────────────────────────
    match /parts/{partId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Combos ────────────────────────────────────────────────────────────────
    function ownsPlayer(playerId) {
      return isAuth() && (
        playerId == uid() ||
        (exists(/databases/$(database)/documents/players/$(playerId)) &&
         get(/databases/$(database)/documents/players/$(playerId)).data.userId == uid())
      );
    }

    match /combos/{comboId} {
      allow read:   if isAuth();
      allow create: if ownsPlayer(request.resource.data.playerId);
      allow update: if ownsPlayer(resource.data.playerId) || isStaff();
      allow delete: if isAdmin();
    }

    // ── ComboHistory (append-only) ────────────────────────────────────────────
    match /comboHistory/{histId} {
      allow read:          if isAuth();
      allow create:        if isStaff();
      allow update, delete: if false;
    }

    // ── Leagues ───────────────────────────────────────────────────────────────
    match /leagues/{leagueId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Tournaments ───────────────────────────────────────────────────────────
    match /tournaments/{tournamentId} {
      allow read:   if true;
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();

      match /groups/{groupId} {
        allow read:  if true;
        allow write: if isStaff();
      }

      match /matches/{matchId} {
        allow read:   if true;
        allow create: if isStaff();
        allow delete: if isAdmin();
        allow update: if isStaff();

        match /scoreAudit/{auditId} {
          allow create:        if isStaff();
          allow read:          if isStaff();
          allow update, delete: if false;
        }
      }

      match /checkins/{playerId} {
        allow read:  if isAuth();
        allow write: if isAdmin();
      }
    }
  }
}
